# EmailOS environment — copy to .env (which is gitignored) and fill in real
# values. NEVER commit .env. The platform injects DATABASE_URL when Neon is
# connected via the database card; APP_SECRET and RESEND_API_KEY you set
# yourself in the environment / .env.

# Required for auth. Generate a strong random value, e.g.:
#   openssl rand -base64 48
# If missing, auth endpoints fail with a clear server-side error.
APP_SECRET=

# Required for any database access (usually injected by the platform, not set
# by hand). If missing, db queries fail server-side with a clear error.
DATABASE_URL=

# OPTIONAL in Slice 1 — required from Slice 3 (Resend connection). Absence is
# handled gracefully: provider status shows "not configured", no calls are made.
# RESEND_API_KEY=